{
  "name": "@lyln/lpm2",
  "version": "0.1.0",
  "description": "PM2 without the Windows named-pipe collision: per-instance IPC namespaces, no unhandled-EPERM crash, zero dependencies.",
  "author": "LiuYunLingNai",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LiuYunLingNai/lpm2.git"
  },
  "homepage": "https://github.com/LiuYunLingNai/lpm2#readme",
  "bugs": {
    "url": "https://github.com/LiuYunLingNai/lpm2/issues"
  },
  "type": "module",
  "bin": {
    "lpm2": "bin/lpm2.mjs"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "test:integration": "node --test \"test/integration.test.mjs\""
  },
  "peerDependencies": {
    "pm2": ">=5.0.0"
  },
  "keywords": [
    "pm2",
    "process-manager",
    "supervisor",
    "daemon",
    "windows",
    "named-pipe",
    "rpc.sock",
    "EPERM",
    "production"
  ],
  "publishConfig": {
    "access": "public"
  }
}
